# Beispiel-Konfiguration. Kopieren nach .env (gitignored) und Werte setzen:
#   cp .env.example .env

# --- n8n ---
# Verschlüsselungsschlüssel für gespeicherte Credentials. PFLICHT (docker compose
# bricht sonst mit klarer Meldung ab). Stabil halten und sichern — bei Verlust sind
# verschlüsselte Credentials nicht mehr lesbar.
# Erzeugen:  python -c "import secrets; print(secrets.token_hex(32))"
N8N_ENCRYPTION_KEY=

# --- FastAPI ---
# Maximale Anzahl gleichzeitig laufender Analysen (Überlastschutz, schützt die GPU).
# Default 2 ist auf eine kleine GPU (~4 GB VRAM, qwen2.5:3b) abgestimmt: eine einzelne
# Analyse löst intern bereits bis zu 3 parallele Classifier-Votes aus. Auf größerer
# Hardware (mehr VRAM / mehrere GPUs) kann der Wert erhöht werden.
MAX_CONCURRENT_ANALYSES=2

# --- Ollama (HOST-seitig, NICHT im Container!) ---
# Ollama läuft hier nicht containerisiert, sondern als `ollama serve` auf dem Host.
# Der tatsächliche GPU-Parallelitätsgrad wird deshalb über eine Host-Umgebungsvariable
# gesteuert, NICHT über diese .env oder docker compose:
#
#   OLLAMA_NUM_PARALLEL — Anzahl gleichzeitig pro Modell verarbeiteter Requests.
#
# Auf ~4 GB VRAM mit qwen2.5:3b ist 2 ein guter Startwert (1, falls der VRAM knapp wird;
# 3 nur, wenn genug VRAM frei ist, damit ein komplettes Vote-Triple zusammen läuft).
# Setzen, dann Ollama neu starten — z. B. unter Windows (PowerShell, dauerhaft):
#
#   setx OLLAMA_NUM_PARALLEL 2     # danach neues Terminal oeffnen + Ollama-Neustart
#
# 

# --- API-Key für POST /analyze ---
# Leer = kein Schutz (nur lokal sinnvoll). In der Cloud Pflicht, sonst meldet /ready "not_ready".
# Clients (n8n, eval/run_eval.py) schicken ihn im Header X-API-Key.
# Erzeugen:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# --- LLM-Provider ---
# ollama (Default) oder azure. Der Azure-Modus braucht eine Identität mit der Rolle
# "Cognitive Services OpenAI User": lokal den Login der Azure CLI, in der Cloud die
# Managed Identity. Im lokalen Docker-Container gibt es keine von beiden — Azure lokal
# deshalb mit uvicorn ausserhalb von Docker testen (siehe docs/azure-setup.md).
LLM_PROVIDER=ollama

# --- Tracing (Langfuse, EU) ---
# Ein Trace pro Ticket-Analyse in Langfuse Cloud. Aus, solange nicht BEIDE Schlüssel gesetzt sind.
# Achtung: Der FastAPI-Service liest .env aus seinem Arbeitsverzeichnis. Für uvicorn lokal
# (inkl. scripts\start-azure-service.ps1) gehören diese Werte nach fastapi-service\.env;
# docker compose reicht sie nicht an den Container weiter.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU-Region (Default). Nur ändern, wenn das Langfuse-Projekt in einer anderen Region liegt.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Stufe, nicht Provider: lokal "local" (Default), in der Container App "production".
# Environments lassen sich in Langfuse weder löschen noch umbenennen, keine Testnamen verwenden.
LANGFUSE_TRACING_ENVIRONMENT=local
# false (Default) = Ticketinhalte werden vor dem Export maskiert, nur Modell, Tokens, Zeiten,
# Tags und Ticket-Referenz gehen raus. true sendet Inhalte: NUR für synthetische Demo-Tickets.
LANGFUSE_CAPTURE_CONTENT=false
# Schlüssel für die Ticket-Referenz (HMAC-SHA256 der Ticket-ID). Leer = Traces ohne Ticket-Referenz.
# Erzeugen:  python -c "import secrets; print(secrets.token_hex(32))"
# In der Cloud liegt er im Key Vault (ticket-id-hmac-key); Nachschlagen: scripts\trace-ref.ps1
TICKET_ID_HMAC_KEY=
