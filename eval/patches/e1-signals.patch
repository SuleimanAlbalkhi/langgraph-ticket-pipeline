diff --git a/fastapi-service/app/graph/urgency_rules.py b/fastapi-service/app/graph/urgency_rules.py
new file mode 100644
index 0000000..83d9746
--- /dev/null
+++ b/fastapi-service/app/graph/urgency_rules.py
@@ -0,0 +1,48 @@
+"""Urgency aus Signalen: das LLM erkennt nur Fakten im Text (Signale), feste
+Regeln hier leiten daraus die Dringlichkeit ab.
+
+Hintergrund (Eval-Baseline): Das LLM hat die Stufenskala als Gesamteindruck
+bewertet und in 30 von 50 Fällen überschätzt — Ärger wurde zu "Eskalation",
+jeder Ausfall zu "critical". Die Regeln setzen die bisherige Spezifikation aus
+dem Classifier-Prompt deterministisch um; Ärger allein ist bewusst kein Signal.
+"""
+from __future__ import annotations
+
+# Reihenfolge = Reihenfolge im Prompt. Jedes Signal ist ein bool.
+SIGNAL_NAMES: tuple[str, ...] = (
+    "frist_genannt",
+    "rechtliche_drohung",
+    "kuendigungsdrohung",
+    "sicherheits_oder_gesundheitsrisiko",
+    "datenverlust",
+    "kerngeschaeft_steht",
+    "explizit_dringend",
+    "explizit_nicht_dringend_oder_nur_info",
+)
+
+_CRITICAL = ("sicherheits_oder_gesundheitsrisiko", "datenverlust", "kerngeschaeft_steht")
+_HIGH     = ("rechtliche_drohung", "kuendigungsdrohung", "frist_genannt", "explizit_dringend")
+_LOW      = ("explizit_nicht_dringend_oder_nur_info",)
+
+
+def coerce_signals(data: dict) -> dict[str, bool]:
+    """Liest die Signale aus der LLM-Antwort. Nur echtes true bzw. der String
+    "true" zählt; fehlende oder sonstige Werte sind False (kein Signal erkannt)."""
+    raw = data.get("signals")
+    if not isinstance(raw, dict):
+        raw = {}
+    return {
+        name: raw.get(name) is True or str(raw.get(name)).strip().lower() == "true"
+        for name in SIGNAL_NAMES
+    }
+
+
+def urgency_from_signals(signals: dict[str, bool]) -> str:
+    """critical > high > low > medium — die höchste zutreffende Stufe gewinnt."""
+    if any(signals.get(name) for name in _CRITICAL):
+        return "critical"
+    if any(signals.get(name) for name in _HIGH):
+        return "high"
+    if any(signals.get(name) for name in _LOW):
+        return "low"
+    return "medium"
