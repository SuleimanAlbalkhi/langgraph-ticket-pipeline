+"""Unit-Tests für die regelbasierte Urgency aus Signalen."""
+import pytest
+
+from app.graph.prompts.classifier import build_prompt
+from app.graph.urgency_rules import SIGNAL_NAMES, coerce_signals, urgency_from_signals
+
+NONE = dict.fromkeys(SIGNAL_NAMES, False)
+
+
+@pytest.mark.parametrize(
+    ("active", "expected"),
+    [
+        ([], "medium"),
+        (["keine_aktion_erwartet"], "low"),
+        (["frist_genannt"], "high"),
+        (["drohung"], "high"),
+        (["ausdruecklich_dringend"], "high"),
+        (["gefahr_oder_datenverlust"], "critical"),
+        (["betrieb_steht_still"], "critical"),
+        # Die höchste zutreffende Stufe gewinnt.
+        (["frist_genannt", "keine_aktion_erwartet"], "high"),
+        (["drohung", "gefahr_oder_datenverlust"], "critical"),
+    ],
+)
+def test_urgency_from_signals(active, expected):
+    assert urgency_from_signals({**NONE, **dict.fromkeys(active, True)}) == expected
+
+
+def test_coerce_signals_defaults_to_false():
+    signals = coerce_signals({"signals": {"frist_genannt": "true", "drohung": "ja", "unbekannt": True}})
+    assert signals == {**NONE, "frist_genannt": True}
+    assert coerce_signals({"signals": None}) == NONE
+    assert coerce_signals({}) == NONE
+
+
+def test_prompt_asks_for_every_signal():
+    prompt = build_prompt("Testticket mit genug Text.")
+    assert all(f'"{name}"' in prompt for name in SIGNAL_NAMES)
