diff --git a/fastapi-service/app/graph/prompts/risk_guard.py b/fastapi-service/app/graph/prompts/risk_guard.py
index 35afc00..a0cb788 100644
--- a/fastapi-service/app/graph/prompts/risk_guard.py
+++ b/fastapi-service/app/graph/prompts/risk_guard.py
@@ -14,11 +14,18 @@ Text:
 Kategorie: {category}
 Dringlichkeit: {urgency}
 
-Kritische Inhalte sind: rechtliche Drohungen, Betrugsvorwürfe,
-Sicherheitsrisiken, extrem verärgerte Kunden mit Eskalationsabsicht.
+risk_flag ist NUR dann true, wenn mindestens einer dieser Punkte im Text steht:
+1. Rechtliche Schritte oder eine externe Stelle werden angekündigt oder sind eingeschaltet:
+   Anwalt, Klage, Gericht, Behörde, Verbraucherzentrale, Datenschutz- oder Aufsichtsbehörde.
+2. Der Kunde droht mit Kündigung oder Anbieterwechsel und setzt dafür eine Frist.
+3. Der Kunde wirft Betrug vor.
+4. Menschen sind in Gefahr (Gesundheit, Sicherheit) oder Daten sind verloren oder offengelegt.
+
+risk_flag ist false bei Ärger, Frust, Beschwerden, harten Worten, Großbuchstaben oder
+Fristen, solange keiner der Punkte 1-4 zutrifft.
 
 Antworte NUR mit diesem JSON-Format:
 {{
   "risk_flag": true oder false,
-  "risk_reason": "Begründung wenn risk_flag true, sonst null"
+  "risk_reason": "wörtliches Zitat der auslösenden Textstelle (höchstens ein Satz), wenn risk_flag true, sonst null"
 }}"""
